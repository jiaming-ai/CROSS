{
  "description": "Monocular CROSS with the improved core (verified loop closure with a DPVO odometry-chain noise model), DPVO motion with asynchronous learned metric scale, and metric two-view retrieval with a DA3 feed-forward fallback for loaded-map references before the map join. Queries of a saved map additionally use --load-map MAP --historical-retrieval-slots 3 --historical-min-score 0.0.",
  "requires_dpvo_checkpoint": true,
  "arguments": [
    "--frontend",
    "streaming_dpvo",
    "--image-size",
    "640",
    "480",
    "--sample-fps",
    "20",
    "--input-fps",
    "20",
    "--replay-timestamps",
    "--paced-input-worker",
    "--input-process",
    "--input-buffer",
    "8",
    "--warmup-models",
    "--freeze-gc",
    "--mask-people",
    "--mask-interval",
    "3",
    "--metric-interval",
    "20",
    "--mapping-interval",
    "10",
    "--chart-aware",
    "--session-recovery",
    "--retrieval-pose",
    "ff",
    "--ff-backend",
    "da3",
    "--ff-checkpoint",
    "depth-anything/DA3-LARGE-1.1",
    "--ff-resolution",
    "336",
    "--ff-fallback-only",
    "--ff-scope",
    "relocalization",
    "--mapping-process",
    "--threads",
    "2",
    "--cross-config",
    "mapping.loop_closure.noise.odom_k_t=1.0",
    "--cross-config",
    "mapping.loop_closure.noise.odom_floor_t=0.005",
    "--cross-config",
    "mapping.loop_closure.noise.odom_k_r=0.2",
    "--cross-config",
    "mapping.loop_closure.noise.odom_floor_r=0.004",
    "--cross-config",
    "mapping.loop_closure.noise.visual_t_a=0.05",
    "--cross-config",
    "mapping.loop_closure.noise.visual_t_b=0.05",
    "--cross-config",
    "mapping.loop_closure.noise.visual_r_a=0.02",
    "--cross-config",
    "mapping.loop_closure.noise.visual_r_b=0.01",
    "--cross-config",
    "mapping.loop_closure.noise.map_t_a=0.1",
    "--cross-config",
    "mapping.loop_closure.noise.map_r_a=0.03"
  ]
}
